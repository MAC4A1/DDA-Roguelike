<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainMenu.uss?fileID=7433441132597879392&amp;guid=74d9d82eca766264ca5eb0899fc1e378&amp;type=3#MainMenu" />
    <ui:VisualElement name="Root" class="root" style="flex-grow: 1;">
        <ui:VisualElement name="Panel" class="panel" style="flex-grow: 1;">
            <ui:VisualElement name="TitleTextContainer" style="flex-grow: 1; width: 100%; height: 30%; min-height: 30%; min-width: 0;">
                <ui:Label text="Unto the Unknown" name="TitleTextLabel" style="width: 100%; height: 50%; -unity-font-style: bold; font-size: 90px; -unity-text-align: middle-center; color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); align-self: auto; justify-content: flex-end; min-width: 0; min-height: 0%;" />
                <ui:Label text="Version A" name="TitleTextLabel" style="width: 100%; height: 50%; -unity-font-style: bold; font-size: 70px; -unity-text-align: middle-center; color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); align-self: auto; justify-content: flex-end; min-width: 0; min-height: 0%;" />
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; align-items: center; justify-content: space-evenly;">
                <ui:Button text="Play" name="Play" double-click-selects-word="true" triple-click-selects-line="true" selectable="true" class="button-container main-menu-button" />
                <ui:Button text="Help" name="Help" double-click-selects-word="true" triple-click-selects-line="true" selectable="true" class="button-container main-menu-button" />
                <ui:Button text="Exit" name="Exit" double-click-selects-word="true" triple-click-selects-line="true" selectable="true" class="button-container main-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
